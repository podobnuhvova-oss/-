SELECT * FROM Водители;

SELECT * FROM Поездки;

SELECT
П.ID_поездки,
В.ФИО AS Водитель,
А.Марка || ' ' || А.Модель AS Автомобиль,
П.Откуда,
П.Куда,
П.Стоимость
FROM Поездки П
JOIN Водители В ON П.ID_водителя = В.ID_водителя
JOIN Автомобили А ON П.ID_машины = А.ID_машины
LIMIT 10;



Запрос 1 — ищет завершённые поездки дороже 1000 и выводит их детали по убыванию стоимости.

SELECT 
    Дата_и_время, 
    Откуда, 
    Куда, 
    Стоимость, 
    Чаевые, 
    Способы_оплаты
FROM Поездки
WHERE ID_статуса_поездки = 1 
  AND Стоимость > 1000
ORDER BY Стоимость DESC;


Запрос 2 — по каждому водителю считает количество завершённых поездок, общую выручку, средний чек и( мин/макс чаевые).

SELECT 
    ID_водителя,
    COUNT(ID_поездки) AS Количество_поездок,
    SUM(Стоимость + Чаевые) AS Общая_выручка,
    AVG(Стоимость) AS Средний_чек,
    MIN(Чаевые) AS Мин_чаевые,
    MAX(Чаевые) AS Макс_чаевые
FROM Поездки
WHERE ID_статуса_поездки = 1
GROUP BY ID_водителя
ORDER BY Общая_выручка DESC;

Запрос 3 — ищет топ-5 экипажей водитель + автомобиль по общей выручке среди завершённых поездок, выводя только ФИО, автомобиль, число поездок и общую выручку.

SELECT 
    В.ФИО AS Водитель,
    А.Марка || ' ' || А.Модель AS Автомобиль,
    COUNT(*) AS Количество_поездок,
    SUM(П.Стоимость + COALESCE(П.Чаевые, 0)) AS Общая_выручка
FROM Поездки П
INNER JOIN Водители В ON П.ID_водителя = В.ID_водителя
INNER JOIN Автомобили А ON П.ID_машины = А.ID_машины
WHERE П.ID_статуса_поездки = 1
GROUP BY В.ID_водителя, А.ID_машины
ORDER BY Общая_выручка DESC
LIMIT 5;
