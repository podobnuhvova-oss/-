PRAGMA foreign_keys = ON;

-- 1. Создание таблиц (DDL)

CREATE TABLE Водители (
ID_водителя INTEGER PRIMARY KEY,
ФИО TEXT NOT NULL,
Телефон_водителя TEXT,
Номер_прав TEXT UNIQUE
);

CREATE TABLE Автомобили (
ID_машины INTEGER PRIMARY KEY,
Госномер TEXT UNIQUE NOT NULL,
Марка TEXT NOT NULL,
Модель TEXT NOT NULL,
Год_выпуска INTEGER
);

CREATE TABLE Клиенты (
ID_клиента INTEGER PRIMARY KEY,
Имя_клиента TEXT,
Телефон_клиента TEXT
);

CREATE TABLE Статусы_поездки (
ID_статуса_поездки INTEGER PRIMARY KEY,
Название_статуса TEXT NOT NULL
);

CREATE TABLE Смены (
ID_смены INTEGER PRIMARY KEY,
ID_водителя INTEGER,
Дата_выхода TEXT,
Начало TEXT,
Конец TEXT,
FOREIGN KEY (ID_водителя) REFERENCES Водители(ID_водителя)
);

CREATE TABLE Поездки (
ID_поездки INTEGER PRIMARY KEY,
ID_клиента INTEGER,
ID_водителя INTEGER,
ID_машины INTEGER,
ID_смены INTEGER,
ID_статуса_поездки INTEGER,
Начало_поездки TEXT,
Конец_поездки TEXT,
Откуда TEXT,
Куда TEXT,
Стоимость REAL,
Оценка_клиента TEXT,
Чаевые REAL,
Способы_оплаты TEXT,
Доплата_за_события REAL,
FOREIGN KEY (ID_клиента) REFERENCES Клиенты(ID_клиента),
FOREIGN KEY (ID_водителя) REFERENCES Водители(ID_водителя),
FOREIGN KEY (ID_машины) REFERENCES Автомобили(ID_машины),
FOREIGN KEY (ID_смены) REFERENCES Смены(ID_смены),
FOREIGN KEY (ID_статуса_поездки) REFERENCES Статусы_поездки(ID_статуса_поездки)
);

